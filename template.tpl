___SANDBOXED_JS_FOR_WEB_TEMPLATE___

const log = require('logToConsole');
const injectScript = require('injectScript');
const createQueue = require('createQueue');

const dataLayerPush = createQueue('dataLayer');

// 1. Debugging: Log the device info/UA provided by the field
const ua = data.userAgentValue;
log('Median Debug - User Agent: ' + (ua || 'Not provided'));

// 2. Injection Logic
log('Median: Median App Detected. Injecting bridge...');

// Retrieve the version from the field, or default to 'latest' if left blank
const version = data.bridgeVersion || 'latest';

// Construct the URL dynamically
const scriptUrl = 'https://unpkg.com/median-js-bridge@' + version + '/dist/median.min.js';

injectScript(
  scriptUrl,
  function () {
    log('Median: Bridge injected successfully');
    
    // Success State with Debug Info
    dataLayerPush({
      event: 'median_injected',
      median_injected: 'yes',
      device_info: ua 
    });
    
    data.gtmOnSuccess();
  },
  function () {
    log('Median: failed to load bridge from CDN');
    
    // Failure State
    dataLayerPush({
      event: 'median_injected',
      median_injected: 'no',
      device_info: ua
    });
    
    data.gtmOnFailure('Median bridge script failed to inject');
  },
  'median-js-bridge'
);


